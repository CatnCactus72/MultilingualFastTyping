{
  "id": "ru",
  "name": "Русский",
  "composer": "translit",
  "schema": 2,
  "options": {
    "case_sensitive_output": true,
    "combining_marks": {
      "'": {
        "combining": "\u0301",
        "bases": "аеиоуыэюя"
      }
    }
  },
  "rules": {
    "а": "a",
    "б": "b",
    "в": ["v", "w"],
    "г": "g",
    "д": "d",
    "е": "e",
    "ё": "yo",
    "ж": "zh",
    "з": "z",
    "и": "i",
    "й": ["y", "j"],
    "к": "k",
    "л": "l",
    "м": "m",
    "н": "n",
    "о": "o",
    "п": "p",
    "р": "r",
    "с": ["s", "c"],
    "т": "t",
    "у": "u",
    "ф": "f",
    "х": ["kh", "h"],
    "ц": "ts",
    "ч": "ch",
    "ш": "sh",
    "щ": "shh",
    "ъ": "##",
    "ы": "y'",
    "ь": "#",
    "э": "eh",
    "ю": "yu",
    "я": "ya",
    "ый": "yy",
    "₽": "$",
    "«": "<<",
    "»": ">>",
    "№": "no#",
    "—": "--"
  },
  "upper": {
    "ый": "ЫЙ"
  }
}